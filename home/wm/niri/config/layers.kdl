// --------- layer rules ---------

layer-rule {
    match namespace="^noctalia-backdrop$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-bar-main$"

    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-notification$"
    block-out-from "screencast"
}
